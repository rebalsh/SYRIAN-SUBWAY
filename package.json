{
  "name": "metro-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:stats": "cross-env NODE_ENV=test jest __tests__/unit/controllers/statsController.test.js",
    "test:lines": "cross-env NODE_ENV=test jest __tests__/unit/controllers/lineController.test.js",
    "load-test": "artillery run load-test.yml",
    "load-test:report": "artillery run --output report.json load-test.yml && artillery report report.json",
    "load-test:quick": "artillery quick --count 1000 --num 50 http://localhost:5000/api/stations"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "autocannon": "^8.0.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.0",
    "nodemailer": "^7.0.12",
    "qrcode": "^1.5.4",
    "redis": "^5.10.0",
    "sequelize": "^6.37.7",
    "stripe": "^20.0.0"
  },
  "devDependencies": {
